{
  "name": "@dropagentx/bot",
  "version": "0.6.0",
  "description": "DropAgentX v3 Telegram bot (Phase 3): grammY glue over a pure orchestrator that talks to the v3 server through the typed contracts client. HITL queue for money actions \u2265 50,000 \u0110. i18n fa/en.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dropagentx/contracts": "workspace:*",
    "@dropagentx/domain": "workspace:*",
    "grammy": "^1.36.0",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./main": {
      "types": "./src/main.ts",
      "default": "./src/main.ts"
    }
  }
}
