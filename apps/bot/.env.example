# DropAgentX v3 bot — ship this file with EMPTY secret values.
# Real values live only in the deployment environment, never in git.

# v3 server root (the /api/v1 base)
SERVER_BASE_URL=

# Must equal the server's KIA_ADMIN_KEY — the bot is a trusted service.
KIA_ADMIN_KEY=

# From @BotFather. Empty = tests / orchestrator-only usage.
TELEGRAM_BOT_TOKEN=

# Chat that receives HITL requests (≥ 50,000 Đ) and can approve/reject.
TELEGRAM_ADMIN_CHAT_ID=

# polling (dev) | webhook (Railway)
BOT_MODE=polling
BOT_WEBHOOK_URL=
PORT=8788

# Queue TTLs in hours
HITL_TTL_HOURS=24
ESCROW_TTL_HOURS=72
