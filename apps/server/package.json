{
  "name": "@dropagentx/server",
  "version": "0.3.0",
  "description": "DropAgentX v3 server: Fastify + Prisma adapter over the pure domain core. Admin service API with OpenAPI from zod contracts.",
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "tsx src/main.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@dropagentx/ai-gateway": "workspace:*",
    "@dropagentx/contracts": "workspace:*",
    "@dropagentx/domain": "workspace:*",
    "@dropagentx/llm": "workspace:*",
    "@prisma/client": "^6.16.2",
    "fastify": "^5.3.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "prisma": "^6.16.2",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  }
}
