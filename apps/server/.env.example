# DropAgentX v3 server — ship this file with EMPTY secret values.
# Real values live only in the deployment environment, never in git.

# SQLite file (relative to prisma/schema.prisma) or a PostgreSQL URL later.
DATABASE_URL=

# Admin key (min 16 chars). If unset, ALL admin endpoints return 503 — fail-closed.
KIA_ADMIN_KEY=

# Telegram bot token for initData verification (Phase 3). Optional now.
TELEGRAM_BOT_TOKEN=

# Dev-only auth (X-Dev-User header). Only honored when TELEGRAM_BOT_TOKEN is empty.
V3_DEV_AUTH=

PORT=8787
RATE_LIMIT_PER_MIN=240
