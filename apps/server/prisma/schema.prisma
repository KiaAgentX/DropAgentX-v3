// DropAgentX v3 — server data model (ADR-003: balances are DERIVED from postings;
// the postings table is the single source of truth).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Account {
  id        String    @id
  kind      String // user | escrow | treasury | mint | burn
  label     String?
  createdAt DateTime  @default(now())
  postings  Posting[]
}

model Tx {
  id             String    @id
  idempotencyKey String?   @unique
  memo           String?
  at             DateTime
  postings       Posting[]
}

model Posting {
  id        Int     @id @default(autoincrement())
  txId      String
  tx        Tx      @relation(fields: [txId], references: [id])
  accountId String
  account   Account @relation(fields: [accountId], references: [id])
  amount    Int

  @@index([accountId])
  @@index([txId])
}

model Escrow {
  id            String    @id
  buyerId       String
  sellerId      String
  amount        Int
  productRef    String?
  status        String
  createdAt     DateTime
  fundedTxId    String?
  settleTxId    String?
  disputeReason String?
  deliveryRef   String?
  expiresAt     DateTime?

  @@index([status])
}

model OutboxEvent {
  id        String   @id @default(cuid())
  kind      String
  payload   String // JSON-encoded DomainEvent
  createdAt DateTime @default(now())
  published Boolean  @default(false)
}

model AuditLog {
  id     String   @id @default(cuid())
  actor  String
  action String
  target String?
  meta   String?
  at     DateTime @default(now())
}

model HitlRequest {
  id           String    @id
  kind         String // ESCROW_RELEASE (additive enum on the wire)
  escrowId     String
  amount       Int
  requesterId  String
  note         String?
  status       String // PENDING | APPROVED | REJECTED | EXPIRED
  createdAt    DateTime  @default(now())
  expiresAt    DateTime
  decidedBy    String?
  decidedAt    DateTime?
  decisionNote String?

  @@index([status])
  @@index([escrowId])
}

// ── Phase 5: AI cycle ─────────────────────────────────────────────────────────

// Per-user AI consumption bill (PRODUCT-THESIS layer 3: transparent per-user
// spend). The daily cap is computed from SUM(totalTokens) over the UTC day.
model AiUsage {
  id               String   @id @default(cuid())
  userId           String
  agent            String
  provider         String
  model            String
  kind             String // chat | route
  promptTokens     Int
  completionTokens Int
  totalTokens      Int
  outcome          String // ok | refused | failed | pending
  at               DateTime @default(now())

  @@index([userId, at])
}

// Marketplace listings (escrow marketplace). Phase 6 migration carries the
// 30 legacy products here; delivery content will live in deliveryPayload so
// files survive host loss (legacy lesson).
model Product {
  id              String   @id
  sellerId        String
  title           String
  description     String
  priceDin        Int
  category        String?
  deliveryPayload String?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  @@index([active])
  @@index([sellerId])
}

// Knowledge base (RAG-lite) — grounds agent answers; staff writes via kb_upsert.
model KbEntry {
  id        String   @id
  title     String
  body      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([title])
}
