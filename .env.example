# DropAgentX v3 — single blank .env template (the QC ritual: this file ships
# EMPTY of secrets; every deployment generates its own keys).

# ── required ─────────────────────────────────────────────────────────────────
# SQLite file (mount a Railway volume at /app/db and point here):
DATABASE_URL=file:./db/v3.db

# Admin key for X-KIA-Key (dashboard + bot). Generate: openssl rand -hex 24
KIA_ADMIN_KEY=

# ── bot (optional — server-only deployments leave these blank) ────────────────
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
# Railway: BOT_MODE=webhook, BOT_WEBHOOK_URL=https://<app>.up.railway.app/api/v1/bot/webhook
BOT_MODE=polling
BOT_WEBHOOK_URL=
TELEGRAM_WEBHOOK_SECRET=

# ── AI cycle (ADR-006 + ADR-008 — all three together, or none) ────────────────
OPENAI_BASE_URL=
OPENAI_API_KEY=
MODEL=
# Optional second/fallback provider (same three-variable shape, all-or-nothing):
OPENAI_BASE_URL_2=
OPENAI_API_KEY_2=
MODEL_2=
# Per-user daily AI token cap (default 120000):
AI_DAILY_TOKEN_CAP=

# ── tuning (sane defaults; usually untouched) ────────────────────────────────
PORT=8787
RATE_LIMIT_PER_MIN=240
